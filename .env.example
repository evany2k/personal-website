# Site URL (set this to your production domain on Vercel)
NEXT_PUBLIC_SITE_URL=https://evanyatrou.dev

# Google Gemini API Key (Free tier from https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Free tier backup models from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Database Logging (Free tier from https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
